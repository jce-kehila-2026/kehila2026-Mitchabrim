{
  "functions": { "source": "functions" },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": {
    "auth": {
      "port": 9199
    },
    "firestore": {
      "port": 8180
    },
    "storage": {
      "port": 9299
    },
    "functions": { "port": 5001 },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
