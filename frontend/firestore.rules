rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helper functions
    // =========================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return hasUserDoc()
        // `status` is the single authoritative account-state field. The
        // legacy `active` boolean may remain as a compatibility mirror, but
        // it must never grant authorization.
        && 'status' in userDoc().data
        && userDoc().data.status == 'active';
    }

    function isAdmin() {
      return isActiveUser()
        && userDoc().data.role == 'admin';
    }

    function isVolunteer() {
      return isActiveUser()
        && userDoc().data.role == 'volunteer';
    }

    function linkedVolunteerId() {
      return userDoc().data.linkedVolunteerId;
    }

    function volunteerReportHasValidShape() {
      return request.resource.data.keys().hasOnly([
          'volunteerId', 'volunteerAuthUid', 'volunteerName', 'volunteerEmail',
          'elderlyId', 'elderlyName', 'reportDate', 'reportType', 'notes',
          'status', 'reviewedAt', 'reviewedBy', 'adminNote', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'volunteerId', 'volunteerAuthUid', 'volunteerName', 'volunteerEmail',
          'elderlyId', 'elderlyName', 'reportDate', 'reportType', 'notes',
          'status', 'reviewedAt', 'reviewedBy', 'adminNote', 'createdAt'
        ])
        && request.resource.data.volunteerId is string
        && request.resource.data.volunteerId.size() > 0
        && request.resource.data.volunteerId.size() <= 200
        && request.resource.data.volunteerAuthUid is string
        && request.resource.data.volunteerName is string
        && request.resource.data.volunteerName.size() > 0
        && request.resource.data.volunteerName.size() <= 200
        && request.resource.data.volunteerEmail is string
        && request.resource.data.volunteerEmail.size() > 0
        && request.resource.data.volunteerEmail.size() <= 320
        && request.resource.data.elderlyId is string
        && request.resource.data.elderlyId.size() > 0
        && request.resource.data.elderlyId.size() <= 200
        && request.resource.data.elderlyName is string
        && request.resource.data.elderlyName.size() > 0
        && request.resource.data.elderlyName.size() <= 200
        && request.resource.data.reportDate is string
        && request.resource.data.reportDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.reportType in [
          'ביקור בית', 'שיחת טלפון', 'ליווי',
          'חלוקת חבילה', 'מפגש פרלמנט', 'אחר'
        ]
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.adminNote == ''
        && request.resource.data.createdAt == request.time;
    }

    function volunteerReportHasValidRelationships() {
      return request.resource.data.volunteerAuthUid == request.auth.uid
        && request.resource.data.volunteerId == linkedVolunteerId()
        && request.resource.data.volunteerEmail == request.auth.token.email
        && exists(/databases/$(database)/documents/volunteers/$(linkedVolunteerId()))
        && exists(/databases/$(database)/documents/elderly/$(request.resource.data.elderlyId))
        && get(/databases/$(database)/documents/elderly/$(request.resource.data.elderlyId)).data.volId == linkedVolunteerId();
    }

    function isOwnVolunteerDoc(volunteerId) {
      return isVolunteer()
        && (
          resource.data.authUid == request.auth.uid
          || linkedVolunteerId() == volunteerId
        );
    }

    // =========================
    // Users
    // =========================
    // Only admin can create/update/delete users.
    // A signed-in user can read only their own user document.
    // Admin can read all users.

    match /users/{userId} {
      allow get: if isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      // Allow a signed-in user to query for their OWN user record by email.
      // This is the login-time fallback when users/{uid} hasn't been mirrored
      // yet (e.g. the admin invited the email before the auth account was
      // linked to that uid). Firestore enforces that the query filter matches
      // the rule, so it can only return the caller's own document.
      allow list: if isAdmin()
        || (
          isSignedIn()
          && resource.data.email == request.auth.token.email
        );

      allow delete: if isAdmin();

      // Admin can freely create/update. A signed-in user may also bootstrap
      // (create) or refresh (update) their OWN users/{uid} document on first
      // login, so long as the doc is safely scoped to them:
      //   * doc id == their auth uid
      //   * email matches their auth token (case-insensitive)
      //   * role is "volunteer" (never self-promote to admin)
      //   * a matching volunteers/{linkedVolunteerId} exists whose email
      //     equals their auth email (proves an admin has actually linked
      //     them to that volunteer profile)
      // This makes the admin invite flow work even when the Firebase Auth
      // account already exists (the admin can't know the uid in that case),
      // without letting an arbitrary signed-in user self-grant volunteer
      // access to an unrelated volunteer profile.
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role == 'volunteer'
          && request.resource.data.email is string
          && request.resource.data.email.lower() == request.auth.token.email.lower()
          && request.resource.data.linkedVolunteerId is string
          && exists(/databases/$(database)/documents/volunteers/$(request.resource.data.linkedVolunteerId))
          && get(/databases/$(database)/documents/volunteers/$(request.resource.data.linkedVolunteerId)).data.email is string
          && get(/databases/$(database)/documents/volunteers/$(request.resource.data.linkedVolunteerId)).data.email.lower() == request.auth.token.email.lower()
        )
        // Admin self-bootstrap on first login when the admin invite could not
        // know the auth uid (auth/email-already-in-use). The invite writes an
        // email-keyed users/{emailToId(email)} doc with role='admin'; on
        // first login the client mirrors it into users/{auth.uid}. This is
        // ONLY allowed when such an admin-created email-keyed doc already
        // exists with role='admin' for the same email — a regular signed-in
        // user cannot self-promote because they cannot create the email-keyed
        // source doc (users create requires isAdmin above).
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role == 'admin'
          && request.resource.data.email is string
          && request.resource.data.email.lower() == request.auth.token.email.lower()
          && exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower().replace('[^a-z0-9]', '_')))
          && get(/databases/$(database)/documents/users/$(request.auth.token.email.lower().replace('[^a-z0-9]', '_'))).data.role == 'admin'
          && get(/databases/$(database)/documents/users/$(request.auth.token.email.lower().replace('[^a-z0-9]', '_'))).data.email.lower() == request.auth.token.email.lower()
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          // Self-updates cannot escalate role or activation.
          && request.resource.data.role == resource.data.role
          && request.resource.data.email.lower() == request.auth.token.email.lower()
          && (
            !('active' in request.resource.data)
            || request.resource.data.active == resource.data.active
          )
          && (
            !('status' in request.resource.data)
            || request.resource.data.status == resource.data.status
          )
          && (
            !('linkedVolunteerId' in request.resource.data)
            || request.resource.data.linkedVolunteerId == resource.data.linkedVolunteerId
          )
        );
    }




    // =========================
    // Projects
    // =========================

    match /projects/{projectId} {
      allow read, write: if isAdmin();

      match /elderlyParticipants/{participantId} {
        allow read, write: if isAdmin();
      }

      match /projectGroups/{groupId} {
        allow read, write: if isAdmin();
      }

      match /{subDocument=**} {
        allow read, write: if isAdmin();
      }
    }

    // =========================
    // Volunteers
    // =========================
    // Admin: full access.
    // Volunteer: read own profile only.
    // Volunteer: update only phone/address/email/updatedAt in own profile.

    match /volunteers/{volunteerId} {
      allow get: if isAdmin()
        || isOwnVolunteerDoc(volunteerId);

      allow list: if isAdmin();

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          isOwnVolunteerDoc(volunteerId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['phone', 'address', 'email', 'updatedAt'])
        );
    }

    // =========================
    // Elderly / Senior Citizens
    // =========================
    // Admin only, because this collection contains sensitive personal data.

    // Admin: full access.
    // Volunteer: read elderly assigned to them (by volId == linkedVolunteerId).

    match /elderly/{elderlyId} {
      allow get: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volId == linkedVolunteerId()
        );

      allow list: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volId == linkedVolunteerId()
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================
    // Volunteer Tasks
    // =========================
    // Admin: full access.
    // Volunteer: read own tasks only.
    // Important:
    // Volunteer queries should be filtered in React by:
    // where("volunteerAuthUid", "==", auth.currentUser.uid)
    // or:
    // where("volunteerId", "==", linkedVolunteerId)

    match /volunteerTasks/{taskId} {
      allow get: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        )
        || (
          isVolunteer()
          && resource.data.volunteerId == linkedVolunteerId()
        );

      allow list: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        )
        || (
          isVolunteer()
          && resource.data.volunteerId == linkedVolunteerId()
        );

      allow create, update, delete: if isAdmin();
    }

    // =========================
    // Volunteer Reports
    // =========================
    // Volunteer: create own reports and read own reports only.
    // Admin: full access.

    match /volunteerReports/{reportId} {
      allow get: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow list: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow create: if isVolunteer()
        && volunteerReportHasValidShape()
        && volunteerReportHasValidRelationships();

      allow update, delete: if isAdmin();
    }

    // =========================
    // Profile Update Requests
    // =========================
    // Volunteer: send and read own update requests.
    // Admin: read/manage all requests.

    match /profileUpdateRequests/{reqId} {
      allow get: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow list: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow create: if isVolunteer()
        && request.resource.data.volunteerAuthUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update, delete: if isAdmin();
    }

    // =========================
    // Admin Notifications
    // =========================
    // Collection used for admin-facing notifications.
    // - Admin: full read/update/delete.
    // - Public site (join_request) and signed-in volunteers
    //   (profile_update_request) may create notifications, but only with a
    //   strict, validated payload that matches the actual app code.

    match /notifications/{notifId} {
      allow read, update, delete: if isAdmin();

      allow create: if
        request.resource.data.keys().hasOnly([
          'audience', 'type', 'title', 'message',
          'requestId', 'read', 'createdAt'
        ])
        && request.resource.data.audience == 'admin'
        && request.resource.data.type in ['join_request', 'profile_update_request']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() > 0
        && request.resource.data.requestId.size() <= 200
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && (
          // Public join_request notifications: no auth required.
          request.resource.data.type == 'join_request'
          || (
            // profile_update_request must come from an active volunteer.
            request.resource.data.type == 'profile_update_request'
            && isVolunteer()
          )
        );
    }


    // =========================
    // Join Requests
    // =========================
    match /joinRequests/{reqId} {
  allow read, update, delete: if isAdmin();

  allow create: if request.resource.data.keys().hasOnly([
      'fullName',
      'phone',
      'note',
      'type',
      'status',
      'createdAt'
    ])
    && request.resource.data.fullName is string
    && request.resource.data.phone is string
    && request.resource.data.note is string
    && request.resource.data.type is string
    && request.resource.data.status == 'new'
    && request.resource.data.createdAt == request.time
    && request.resource.data.fullName.size() >= 2
    && request.resource.data.fullName.size() <= 200
    && request.resource.data.phone.size() >= 5
    && request.resource.data.phone.size() <= 40
    && request.resource.data.note.size() <= 2200
    && request.resource.data.type in [
      'אזרח ותיק',
      'פונה עבור אזרח ותיק אחר',
      'מתעניין בהתנדבות',
      'איש מקצוע',
      'אחר'
    ];
}

    // =========================
    // Volunteer Notifications
    // =========================
    // Admin: create/delete/manage.
    // Volunteer: read own notifications only and update only read field.

    match /volunteerNotifications/{notifId} {
      allow get: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow list: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        );
    }

    // =========================
    // Public Site Content
    // =========================
    // Public content: readable by everyone.
    // Admin only can edit.

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================
    // Settings
    // =========================
    // Public read is acceptable only if settings contains public data
    // such as areas/neighborhoods and general public site settings.
    // Admin only can edit.

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================
    // Elderly Contact Persons
    // =========================

    match /elderlyContactPersons/{docId} {
      allow read, write: if isAdmin();
    }

    match /elderlyContactLinks/{docId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // Organizations
    // =========================

    match /organizations/{docId} {
      allow read, write: if isAdmin();
    }

    match /organizationContacts/{docId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // Images (Gallery)
    // =========================
    // Admin: full access to all image documents.
    // Anyone (including anonymous visitors): may read image documents only
    // when isPublic == true. Firestore enforces that list/query filters
    // match the rule, so the public site query
    //   where("isPublic", "==", true)
    // is required for anonymous reads to succeed. Private images
    // (isPublic == false or missing) remain admin-only.
    // Writes (create/update/delete) are admin-only.

    match /images/{imageId} {
      allow get: if isAdmin()
        || (resource.data.isPublic == true);

      allow list: if isAdmin()
        || (resource.data.isPublic == true);

      allow create, update, delete: if isAdmin();
    }



    // =========================
    // Admin fallback for all remaining CRM collections
    // =========================
    // This prevents admin pages from breaking when the app uses collections
    // that are not explicitly listed above.
    //
    // Admin can access remaining collections.
    // Public users and volunteers are blocked unless a collection has
    // an explicit rule above.

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
