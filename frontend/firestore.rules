rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helper functions
    // =========================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return hasUserDoc()
        && (
          userDoc().data.status == 'active'
          || userDoc().data.active == true
        );
    }

    function isAdmin() {
      return isActiveUser()
        && userDoc().data.role == 'admin';
    }

    function isVolunteer() {
      return isActiveUser()
        && userDoc().data.role == 'volunteer';
    }

    function linkedVolunteerId() {
      return userDoc().data.linkedVolunteerId;
    }

    function isOwnVolunteerDoc(volunteerId) {
      return isVolunteer()
        && (
          resource.data.authUid == request.auth.uid
          || linkedVolunteerId() == volunteerId
        );
    }

    // =========================
    // Users
    // =========================
    // فقط الأدمن ينشئ/يعدل/يحذف users.
    // المستخدم يقرأ مستنده فقط.
    // لا تسمح للمستخدم العادي بإنشاء users/{uid} لنفسه.

    match /users/{userId} {
      allow get: if isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();
    }

    // =========================
    // Legacy allowedUsers
    // =========================

    match /allowedUsers/{docId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // Projects
    // =========================

    match /projects/{projectId} {
      allow read, write: if isAdmin();

      match /elderlyParticipants/{participantId} {
        allow read, write: if isAdmin();
      }

      match /projectGroups/{groupId} {
        allow read, write: if isAdmin();
      }
    }

    // =========================
    // Volunteers
    // =========================
    // Admin: كامل الصلاحية.
    // Volunteer: يقرأ ملفه فقط.
    // Volunteer: يعدل فقط phone/address/email/updatedAt في ملفه.

    match /volunteers/{volunteerId} {
      allow get: if isAdmin()
        || isOwnVolunteerDoc(volunteerId);

      allow list: if isAdmin();

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          isOwnVolunteerDoc(volunteerId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['phone', 'address', 'email', 'updatedAt'])
        );
    }

    // =========================
    // Elderly
    // =========================
    // حاليا Admin فقط لأنها تحتوي بيانات حساسة.
    // إذا أردت أن يرى المتطوع فقط المواطن/المواطنين المرتبطين به،
    // يجب إضافة حقل واضح مثل assignedVolunteerAuthUid أو assignedVolunteerId.

    match /elderly/{elderlyId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // Volunteer Tasks
    // =========================
    // Admin: كامل الصلاحية.
    // Volunteer: يقرأ مهامه فقط.
    // ملاحظة مهمة:
    // لكي يعمل list للمتطوع، يجب أن يكون كود React فيه query مفلتر:
    // where("volunteerAuthUid", "==", auth.currentUser.uid)
    // أو:
    // where("volunteerId", "==", linkedVolunteerId)

    match /volunteerTasks/{taskId} {
      allow get: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        )
        || (
          isVolunteer()
          && resource.data.volunteerId == linkedVolunteerId()
        );

      allow list: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        )
        || (
          isVolunteer()
          && resource.data.volunteerId == linkedVolunteerId()
        );

      allow create, update, delete: if isAdmin();
    }

    // =========================
    // Volunteer Reports
    // =========================
    // Volunteer: ينشئ تقرير لنفسه ويقرأ تقاريره فقط.
    // Admin: كامل الصلاحية.

    match /volunteerReports/{reportId} {
      allow get: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow list: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow create: if isVolunteer()
        && request.resource.data.volunteerAuthUid == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // =========================
    // Profile Update Requests
    // =========================
    // Volunteer: يرسل طلب تعديل بياناته ويقرأ طلباته فقط.
    // Admin: يقرأ الكل ويوافق/يرفض.

    match /profileUpdateRequests/{reqId} {
      allow get: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow list: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow create: if isVolunteer()
        && request.resource.data.volunteerAuthUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update, delete: if isAdmin();
    }

    // =========================
    // Admin Notifications
    // =========================
    // Admin: يقرأ ويدير.
    // Public/Volunteer: يسمح بإنشاء إشعار فقط موجه للأدمن.
    // تم تقييد الحقول لتقليل التخريب.

    match /notifications/{notifId} {
      allow read, update, delete: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly([
          'audience',
          'type',
          'title',
          'message',
          'createdAt',
          'read'
        ])
        && request.resource.data.audience == 'admin'
        && request.resource.data.read == false;
    }

    // =========================
// Join Requests
// =========================
// Public website can submit a join/contact request.
// Admin only can read and manage requests.

match /joinRequests/{reqId} {
  allow read, update, delete: if isAdmin();

  allow create: if request.resource.data.keys().hasOnly([
      'firstName',
      'lastName',
      'fullName',
      'name',
      'phone',
      'email',
      'requestType',
      'reason',
      'message',
      'notes',
      'status',
      'createdAt'
    ])
    && request.resource.data.status == 'new';
}

    // =========================
    // Volunteer Notifications
    // =========================
    // Admin: يكتب ويدير.
    // Volunteer: يقرأ إشعاراته فقط ويستطيع تغيير read فقط.

    match /volunteerNotifications/{notifId} {
      allow get: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow list: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
        );

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          isVolunteer()
          && resource.data.volunteerAuthUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        );
    }

    // =========================
    // Public Site Content
    // =========================
    // محتوى الموقع العام: قراءة للجميع، كتابة للأدمن فقط.

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================
    // Elderly Contact Persons
    // =========================

    match /elderlyContactPersons/{docId} {
      allow read, write: if isAdmin();
    }

    match /elderlyContactLinks/{docId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // Organizations
    // =========================

    match /organizations/{docId} {
      allow read, write: if isAdmin();
    }

    match /organizationContacts/{docId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // Settings
    // =========================
    // القراءة العامة مقبولة فقط إذا كانت settings تحتوي معلومات عامة
    // مثل مناطق وأحياء لا تكشف بيانات شخصية.
    // الكتابة للأدمن فقط.

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================
    // Default deny
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}