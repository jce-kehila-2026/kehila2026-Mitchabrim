rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requesting user an active admin in users/{uid}?
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        );
    }

    match /users/{userId} {
      // A user can always read their own role document during login.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Authenticated users may query (needed for the email/fullName
      // fallback lookup during login, before the role is known).
      allow list: if request.auth != null;
      // Admins manage users. A user may also create their OWN doc
      // (users/{auth.uid}) — used only by the VITE_ADMIN_EMAIL bootstrap.
      allow create: if isAdmin() || request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    // Legacy collection from the previous implementation — admins only.
    match /allowedUsers/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Projects — admins only (including subcollections).
    match /projects/{projectId} {
      allow read, write: if isAdmin();

      match /elderlyParticipants/{participantId} {
        allow read, write: if isAdmin();
      }

      match /projectGroups/{groupId} {
        allow read, write: if isAdmin();
      }
    }

    // Volunteers — admin full access; authenticated volunteers may read so
    // the volunteer site can look up volunteers/{doc} where authUid==uid.
    // Volunteers may also update ONLY phone, address, email, updatedAt on
    // their own linked volunteer document.
    match /volunteers/{volunteerId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.auth != null
          && resource.data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['phone','address','email','updatedAt'])
        )
        || (
          request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedVolunteerId == volunteerId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['phone','address','email','updatedAt'])
        );
    }

    // Volunteer tasks — admin full access; volunteers can only read their own.
    match /volunteerTasks/{taskId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.volunteerAuthUid == request.auth.uid)
        || (
          request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedVolunteerId == resource.data.volunteerId
        );
      allow list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Elderly — admin full access; authenticated volunteers may read so the
    // report form can list elderly assigned to them.
    match /elderly/{elderlyId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Volunteer reports — volunteers can create their own and read their own,
    // but cannot edit or delete. Admins have full access.
    match /volunteerReports/{reportId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.volunteerAuthUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.volunteerAuthUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    // Admin notifications — admins read/manage; any user (including
    // unauthenticated public-site visitors) can CREATE a notification
    // addressed to the admin audience (e.g. when a visitor submits a
    // join request, or a volunteer submits a profile update request).
    match /notifications/{notifId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.audience == 'admin';
    }

    // Join requests submitted from the public website — anyone can create,
    // admins read and manage.
    match /joinRequests/{reqId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    // Profile update requests — volunteers create/read their own; admins
    // read all and approve/reject. Volunteers cannot edit or delete.
    match /profileUpdateRequests/{reqId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.volunteerAuthUid == request.auth.uid);
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.volunteerAuthUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Volunteer notifications — admins write; volunteers read their own and
    // may only toggle the `read` flag on their own notifications.
    match /volunteerNotifications/{notifId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.volunteerAuthUid == request.auth.uid);
      allow list: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.auth != null
          && resource.data.volunteerAuthUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        );
    }

    // Public site content (CMS) — anyone can read, admins write.
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default: deny. Add app-specific rules for your other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}