# Copy to .env.local on each development machine. Never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=mitchabrim-jce2026
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=<RECAPTCHA_ENTERPRISE_SITE_KEY>

# Keep the shared/base value false. To use Firebase's documented debug-token
# workflow, set this to true in the ignored .env.development.local file only.
VITE_FIREBASE_APPCHECK_DEBUG=false
VITE_FIREBASE_USE_EMULATORS=false
