# Copy to .env.local on each development machine. Never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=mitchabrim-jce2026
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Development only. Firebase generates one debug token per browser origin.
# Register each localhost/LAN/device token in Firebase App Check; do not share
# or commit debug tokens and do not disable App Check enforcement.
VITE_FIREBASE_APPCHECK_DEBUG=true
VITE_FIREBASE_USE_EMULATORS=false
