rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // -----------------------------
    // Helpers
    // -----------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return hasUserDoc()
        // Keep Storage authorization identical to Firestore: only the
        // authoritative status field may activate an account.
        && 'status' in userDoc().data
        && userDoc().data.status == 'active';
    }

    function isAdmin() {
      return isActiveUser()
        && userDoc().data.role == 'admin';
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf';
    }

    function maxSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    function validImageUpload5MB() {
      return request.resource == null
        || (isImage() && maxSize(5));
    }

    function validReceiptUpload10MB() {
      return request.resource == null
        || (isImageOrPdf() && maxSize(10));
    }

    // =============================
    // Gallery images
    // =============================
    // Public files are readable by everyone. Private files and the legacy
    // flat images/ path require an active admin. The legacy path remains
    // writable/readable by admins only during the controlled migration.

    match /images/public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && validImageUpload5MB();
    }

    match /images/private/{allPaths=**} {
      // Reads have no upload payload. Keep upload validation exclusively on
      // writes so authenticated Admin reads do not depend on request.resource.
      allow read: if isAdmin();
      allow write: if isAdmin() && validImageUpload5MB();
    }

    match /images/{legacyFile} {
      allow read: if isAdmin();
      allow write: if isAdmin() && validImageUpload5MB();
    }

    // =============================
    // Receipts
    // =============================
    // receipts/ is private.
    // Only admin can read, upload, edit, or delete.
    // Images or PDFs only, max 10MB.

    match /receipts/{allPaths=**} {
      allow read, write: if isAdmin() && validReceiptUpload10MB();
    }

    // =============================
    // Default deny
    // =============================
    // Any other path is blocked.

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
